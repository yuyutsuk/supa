vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

client: Web / mobile client

cloudflare: Cloudflare edge deployment {
  label: "Cloudflare edge deployment\nSingle deployed service: items-api-worker"

  worker: Worker entrypoint / router {
    shape: rectangle
    label: "Worker entrypoint / router\nResponsibility:\n- route /api/auth/*\n- handle /items CRUD\n- return API responses"
  }

  better_auth: Better Auth module (in-process) {
    shape: rectangle
    label: "Better Auth module (in-process)\nResponsibility:\n- /api/auth/* handlers\n- issue and verify session cookies\n- persist user/session/account/verification/rate_limit"
  }

  jwt_bridge: Supabase JWT bridge (in-process) {
    shape: rectangle
    label: "Supabase JWT bridge (in-process)\nResponsibility:\n- read Better Auth session user.id\n- mint ES256 bridge JWT\n- set sub=user.id, role=authenticated"
  }

  worker_key: Worker Secret {
    shape: cylinder
    label: "ES256 private JWK\nSUPABASE_JWT_SIGNING_KEY"
  }
}

deploy_note: Deploy clarity {
  shape: rectangle
  label: "Better Auth is not a separate deployment.\nIt runs inside the same Worker process."
}

hyperdrive: Cloudflare Hyperdrive {
  shape: rectangle
  label: "SUPABASE_HYPERDRIVE\npooled Postgres connection"
}

supabase: Supabase platform {
  data_api: Supabase Data API {
    shape: rectangle
    label: "Supabase Data API (PostgREST)\nResponsibility:\n- verify Worker-signed JWT\n- execute SQL request"
  }

  supabase_key: Supabase signing key {
    shape: cylinder
    label: "Imported ES256 public key\nverifies Worker bridge JWT"
  }

  auth_tables: Postgres auth tables {
    shape: cylinder
    label: "user\nsession\naccount\nverification\nrate_limit"
  }

  app_db: Postgres app tables + RLS {
    shape: cylinder
    label: "items + RLS\nResponsibility:\n- enforce auth.uid() ownership"
  }
}

legacy_d1: Legacy D1 identity directory {
  shape: cylinder
  label: "access_identities (legacy)\nnot used by Better Auth path"
}

client -> cloudflare.worker: "1. request /api/auth/* or /items"
cloudflare.worker -> cloudflare.better_auth: "2a. /api/auth/* in-process call"
cloudflare.better_auth -> hyperdrive: "3. read/write auth state"
hyperdrive -> supabase.auth_tables: "4. SQL operations"

cloudflare.worker -> cloudflare.better_auth: "2b. /items: getSession() in-process call"
cloudflare.worker -> cloudflare.jwt_bridge: "5. mint short-lived bridge JWT"
cloudflare.jwt_bridge -> cloudflare.worker_key: "6. sign with ES256 private JWK"
cloudflare.worker -> supabase.data_api: "7. call Data API with Bearer bridge JWT"
supabase.data_api -> supabase.supabase_key: "8. verify ES256 signature + kid"
supabase.data_api -> supabase.app_db: "9. execute CRUD with JWT claims"
supabase.app_db -> supabase.data_api: "10. RLS allow/deny"
supabase.data_api -> cloudflare.worker: "11. result"
cloudflare.worker -> client: "12. API response"

cloudflare.worker -> legacy_d1: "No runtime dependency"
deploy_note -> cloudflare.better_auth: "same deployed unit"

cloudflare.style.fill: "#e3f2fd"
cloudflare.worker.style.fill: "#bbdefb"
cloudflare.better_auth.style.fill: "#ffe0b2"
cloudflare.jwt_bridge.style.fill: "#c8e6c9"
deploy_note.style.fill: "#fff9c4"
hyperdrive.style.fill: "#f3e5f5"
supabase.data_api.style.fill: "#e8f5e9"
supabase.app_db.style.fill: "#fce4ec"
legacy_d1.style.fill: "#f5f5f5"
