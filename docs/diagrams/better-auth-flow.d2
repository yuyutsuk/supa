vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

client: Browser / API client

cloudflare: Cloudflare edge deployment {
  label: "Cloudflare edge deployment\nSingle deployed service: items-api-worker"

  worker: Worker entrypoint / router {
    shape: rectangle
    label: "Worker entrypoint / router\nResponsibility:\n- route /api/auth/*\n- serve /ui static assets\n- handle /items CRUD at /\n- return API responses"
  }

  better_auth: Better Auth module (in-process) {
    shape: rectangle
    label: "Better Auth module (in-process)\nResponsibility:\n- /api/auth/* handlers\n- issue bearer session token (set-auth-token)\n- verify Authorization: Bearer token\n- persist user/session/account/verification/rate_limit"
  }

  auth_secret: Worker Secret {
    shape: cylinder
    label: "BETTER_AUTH_SECRET\nsigns/verifies Better Auth session token"
  }

  jwt_bridge: Supabase JWT bridge (in-process) {
    shape: rectangle
    label: "Supabase JWT bridge (in-process)\nResponsibility:\n- read Better Auth session user.id\n- mint ES256 bridge JWT\n- set sub=user.id, role=authenticated"
  }

  worker_key: Worker Secret {
    shape: cylinder
    label: "ES256 private JWK\nSUPABASE_JWT_SIGNING_KEY"
  }
}

deploy_note: Deploy clarity {
  shape: rectangle
  label: "Better Auth is not a separate deployment.\nIt runs inside the same Worker process."
}

token_note: Token boundaries {
  shape: rectangle
  label: "Token boundaries\n- Better Auth bearer token: signed session token (client -> Worker)\n- Supabase bridge JWT: internal Worker -> Data API only"
}

ui_assets: Worker static assets {
  shape: rectangle
  label: "ASSETS binding (ui/dist)\nServes Astro UI at /ui"
}

hyperdrive: Cloudflare Hyperdrive {
  shape: rectangle
  label: "SUPABASE_HYPERDRIVE\npooled Postgres connection"
}

supabase: Supabase platform {
  data_api: Supabase Data API {
    shape: rectangle
    label: "Supabase Data API (PostgREST)\nResponsibility:\n- verify Worker-signed JWT\n- execute SQL request"
  }

  supabase_key: Supabase signing key {
    shape: cylinder
    label: "Imported ES256 public key\nverifies Worker bridge JWT"
  }

  auth_tables: Postgres auth tables {
    shape: cylinder
    label: "user\nsession\naccount\nverification\nrate_limit"
  }

  app_db: Postgres app tables + RLS {
    shape: cylinder
    label: "items + RLS\nResponsibility:\n- enforce auth.uid() ownership"
  }
}

legacy_d1: Legacy D1 identity directory {
  shape: cylinder
  label: "access_identities (legacy)\nnot used by Better Auth path"
}

client -> cloudflare.worker: "1. request"

cloudflare.worker -> ui_assets: "2a. GET /ui or /ui/*"
ui_assets -> cloudflare.worker: "3a. index.html / static response"
cloudflare.worker -> client: "4a. UI response"

cloudflare.worker -> cloudflare.better_auth: "2b. /api/auth/* in-process call"
cloudflare.better_auth -> cloudflare.auth_secret: "3b. sign session token"
cloudflare.better_auth -> hyperdrive: "4b. read/write auth state"
hyperdrive -> supabase.auth_tables: "5b. SQL operations"
cloudflare.better_auth -> cloudflare.worker: "6b. set-auth-token response header"
cloudflare.worker -> client: "7b. auth response"

cloudflare.worker -> cloudflare.better_auth: "2c. / CRUD: getSession() in-process call"
cloudflare.better_auth -> cloudflare.auth_secret: "3c. verify bearer session token"
cloudflare.better_auth -> hyperdrive: "4c. resolve session + user"
cloudflare.worker -> cloudflare.jwt_bridge: "5c. mint short-lived bridge JWT"
cloudflare.jwt_bridge -> cloudflare.worker_key: "6c. sign with ES256 private JWK"
cloudflare.worker -> supabase.data_api: "7c. call Data API with Bearer bridge JWT"
supabase.data_api -> supabase.supabase_key: "8c. verify ES256 signature + kid"
supabase.data_api -> supabase.app_db: "9c. execute CRUD with JWT claims"
supabase.app_db -> supabase.data_api: "10c. RLS allow/deny"
supabase.data_api -> cloudflare.worker: "11c. result"
cloudflare.worker -> client: "12c. API response"

cloudflare.worker -> legacy_d1: "No runtime dependency"
deploy_note -> cloudflare.better_auth: "same deployed unit"
token_note -> cloudflare.worker: "security contract"

cloudflare.style.fill: "#e3f2fd"
cloudflare.worker.style.fill: "#bbdefb"
cloudflare.better_auth.style.fill: "#ffe0b2"
cloudflare.auth_secret.style.fill: "#fff3e0"
cloudflare.jwt_bridge.style.fill: "#c8e6c9"
ui_assets.style.fill: "#e1f5fe"
deploy_note.style.fill: "#fff9c4"
token_note.style.fill: "#fffde7"
hyperdrive.style.fill: "#f3e5f5"
supabase.data_api.style.fill: "#e8f5e9"
supabase.app_db.style.fill: "#fce4ec"
legacy_d1.style.fill: "#f5f5f5"
