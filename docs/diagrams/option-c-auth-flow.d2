vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

client: Browser / API client

access: Cloudflare Access {
  shape: rectangle
  label: "Cloudflare Access\nidentity-provider login + policy"
}

worker: Cloudflare Worker\nitems-api-worker {
  shape: rectangle
  label: "Cloudflare Worker\nvalidates Access; mints B and C"
}

access_jwks: Cloudflare Access JWKS {
  shape: cylinder
  label: "Access JWKS\n/cdn-cgi/access/certs"
}

worker_key: Worker Secret {
  shape: cylinder
  label: "ES256 private JWK\nSUPABASE_JWT_SIGNING_KEY"
}

identity_db: Cloudflare D1 identity directory {
  shape: cylinder
  label: "access_identities\nAccess sub y → canonical x"
}

supabase: Supabase Data API {
  shape: rectangle
  label: "Supabase Data API\nPostgREST + RPC"
}

supabase_key: Supabase signing key {
  shape: cylinder
  label: "Imported ES256 signing key\npublic key verifies bridge JWT"
}

resolver: resolve_or_provision\n_current_identity() {
  shape: rectangle
  label: "SECURITY DEFINER RPC\nreturns canonical x"
}

identity_map: public.user_identities {
  shape: cylinder
  label: "cloudflare_access + y\n→ canonical user_id x"
}

app_users: public.app_users {
  shape: cylinder
  label: "canonical users\nid=x; email"
}

postgres: Postgres + RLS {
  shape: cylinder
  label: "items.user_id=x\nauth.uid()=x\nrole=authenticated"
}

gotrue: Supabase GoTrue {
  shape: rectangle
  label: "GoTrue remains enabled\nexisting Supabase-auth flow"
}

legacy_client: Existing client

client -> access: "1. request Worker URL"
access -> client: "2. Access login/session"
access -> worker: "3. JWT A — Cf-Access-Jwt-Assertion\nRS256; sub=y; email; aud"
worker -> access_jwks: "4. verify A: signature + issuer + aud"
worker -> identity_db: "5. normal path: lookup y → x"
identity_db -> worker: "6. x (directory hit)"
worker -> worker_key: "7. normal path: sign JWT C (5 min)\nsub=x; cf_access_sub=y; role=authenticated"
worker -> supabase: "8. normal path: CRUD with Bearer C\nWorker derives user_id=x"
supabase -> supabase_key: "9. verify C: ES256 + kid"
supabase -> postgres: "10. CRUD; RLS auth.uid()=x"
postgres -> supabase: "11. permitted rows / mutation"
supabase -> worker: "12. result"
worker -> client: "13. API response (never bridge JWT)"

worker -> worker_key: "D1 miss only: sign JWT B (temporary, 5 min)\nsub=y; bridge_stage=identity_resolution"
worker -> supabase: "D1 miss only: resolver RPC with Bearer B"
supabase -> resolver: "auth.uid()=y; email from JWT"
resolver -> identity_map: "resolve existing y→x"
resolver -> app_users: "otherwise match/create x by verified email\nand persist y→x"
resolver -> worker: "return x"
worker -> identity_db: "persist y → x for future D1 hits"

legacy_client -> gotrue: "existing email/password or OAuth"
gotrue -> legacy_client: "Supabase Auth JWT"
legacy_client -> supabase: "existing direct Data API flow"
gotrue -> app_users: "old UUID x backfilled\nGoTrue can be retired later"

worker.style.fill: "#e3f2fd"
access.style.fill: "#fff3e0"
supabase.style.fill: "#e8f5e9"
postgres.style.fill: "#f3e5f5"
gotrue.style.fill: "#f5f5f5"
